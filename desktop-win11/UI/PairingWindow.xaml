<Window x:Class="LanBridge.UI.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привязка смартфона — LanBridge"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1115"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="BorderBrush" Value="#8B949E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F81F7" />
            <Setter Property="BorderBrush" Value="#2F81F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388BFD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Подключение смартфона" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <TextBlock Text="Отсканируйте этот QR-код камерой в приложении LanBridge на Android"
                       FontSize="13" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- QR Code Container -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}">
            <Image x:Name="QrCodeImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <!-- Fingerprint & Token Info -->
        <Border Grid.Row="2" Background="#161920" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,16,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Отпечаток TLS-сертификата (SHA-256):" FontSize="11" Foreground="#8B949E" />
                        <TextBlock x:Name="FingerprintText" FontSize="11" FontFamily="Consolas"
                                   Foreground="#58A6FF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Копировать" Click="CopyFingerprint_Click"
                            Padding="8,4" FontSize="11" Margin="8,0,0,0" />
                </Grid>

                <Separator Background="#21262D" Margin="0,8,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IP-адрес хоста для прямого подключения:" FontSize="11" Foreground="#8B949E" />
                        <TextBlock x:Name="HostIpText" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Обновить QR" Click="RefreshQr_Click"
                            Padding="8,4" FontSize="11" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Paired Devices List -->
        <GroupBox Grid.Row="3" Header="Привязанные устройства" Foreground="#8B949E"
                  BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,16">
            <ListView x:Name="PairedDevicesListView" Background="Transparent" BorderThickness="0"
                      Foreground="#F0F6FC" Margin="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="#8B949E" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Отвязать" Tag="{Binding Id}"
                                    Click="UnpairDevice_Click" FontSize="11" Padding="8,4"
                                    Background="#3A1D20" BorderBrush="#F85149" Foreground="#F85149" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- Close Button -->
        <Button Grid.Row="4" Content="Готово" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Width="100" Click="Close_Click" />
    </Grid>
</Window>
