<Application x:Class="LanBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0F1115" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#161920" />
        <SolidColorBrush x:Key="SurfaceVariantBackground" Color="#21262D" />
        <SolidColorBrush x:Key="AccentPrimary" Color="#2F81F7" />
        <SolidColorBrush x:Key="BorderDark" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
    </Application.Resources>
</Application>
