<Window x:Class="LanBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanBridge"
        Width="400" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <!-- Custom Switch Style -->
        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="44" Height="22">
                                <Border x:Name="SwitchTrack" CornerRadius="11" Background="#21262D"
                                        BorderBrush="#30363D" BorderThickness="1" />
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#8B949E"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2F81F7" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#2F81F7" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="BorderBrush" Value="#8B949E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F81F7" />
            <Setter Property="BorderBrush" Value="#2F81F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388BFD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Context menu / items style -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Outer Window Card with Shadow & Border -->
    <Border Background="#0F1115" BorderBrush="#30363D" BorderThickness="1"
            CornerRadius="12" Margin="6" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Status & Sync Toggle -->
                <RowDefinition Height="Auto" /> <!-- Drag & Drop Zone -->
                <RowDefinition Height="*" />    <!-- Clipboard History Feed -->
                <RowDefinition Height="Auto" /> <!-- Footer / Settings -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LanBridge" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#161920" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="10" Foreground="#8B949E" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Привязать (QR)" Style="{StaticResource PrimaryButton}"
                            Click="OpenPairing_Click" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                    <Button Content="✕" Click="CloseFlyout_Click" Width="28" Height="28"
                            Padding="0" FontSize="12" ToolTip="Скрыть в трей" />
                </StackPanel>
            </Grid>

            <!-- 2. Status & Large Sync Switch Card -->
            <Border Grid.Row="1" Background="#161920" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Phone Connection Indicator -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Dot -->
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8B949E"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />

                        <!-- Device Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceNameText" Text="Смартфон не подключен"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="DeviceDetailsText" Text="Ожидание соединения в локальной сети…"
                                       FontSize="11" Foreground="#8B949E" />
                        </StackPanel>

                        <!-- Ping Badge -->
                        <Border Grid.Column="2" x:Name="PingBadge" Background="#21262D" CornerRadius="4"
                                Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="PingText" Text="12 ms" FontSize="10" Foreground="#58A6FF" />
                        </Border>
                    </Grid>

                    <Separator Background="#21262D" Margin="0,0,0,10" />

                    <!-- Large Sync Switch -->
                    <CheckBox x:Name="AutoSyncToggle" Style="{StaticResource ModernSwitch}"
                              IsChecked="True" Checked="AutoSyncToggle_Changed" Unchecked="AutoSyncToggle_Changed">
                        <StackPanel>
                            <TextBlock Text="Автосинхронизация буфера" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            <TextBlock Text="Мгновенно передавать скопированный текст и снимки" FontSize="11" Foreground="#8B949E" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- 3. Drag & Drop Zone -->
            <Border Grid.Row="2" x:Name="DropZoneBorder"
                    Background="#161920" BorderBrush="#2F81F7" BorderThickness="1.5"
                    CornerRadius="8" Padding="12" Margin="0,0,0,12"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="DropZoneTitle" Text="📁 Перетащите файлы сюда для отправки"
                               FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropZoneSubtext" Text="Мгновенная потоковая передача (до 10+ ГБ) на телефон"
                               FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,2,0,0" />

                    <!-- Progress Bar for File Streaming -->
                    <StackPanel x:Name="TransferProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <ProgressBar x:Name="TransferProgressBar" Height="4" Maximum="100" Value="0"
                                     Foreground="#2F81F7" Background="#21262D" BorderThickness="0" />
                        <TextBlock x:Name="TransferStatusText" Text="Передача: 0%..."
                                   FontSize="10" Foreground="#8B949E" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Clipboard History Feed (Last 25) -->
            <Border Grid.Row="3" Background="#161920" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="Лента истории буфера (последние 25)" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" />
                        <Button Content="Очистить" Click="ClearHistory_Click" HorizontalAlignment="Right"
                                Padding="6,2" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="#8B949E" />
                    </Grid>

                    <!-- History Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Item Content -->
                                            <StackPanel Grid.Column="0">
                                                <!-- If Text / Link -->
                                                <TextBlock Text="{Binding DisplayPreview}" FontSize="12"
                                                           Foreground="#F0F6FC" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="36" TextWrapping="Wrap" />

                                                <!-- If Image Thumbnail -->
                                                <Image Source="{Binding ImagePreview}" MaxHeight="80"
                                                       MaxWidth="200" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="{Binding DisplayTime}" FontSize="10" Foreground="#8B949E" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Copy Button -->
                                            <Button Grid.Column="1" Content="Копировать" Tag="{Binding}"
                                                    Click="CopyHistoryItem_Click" FontSize="11" Padding="8,4"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 5. Footer & System Integration -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="StartupCheckBox" Content="Запускать вместе с Windows"
                          Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"
                          Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />

                <Button Grid.Column="1" Content="Папка загрузок" Click="OpenDownloads_Click"
                        Padding="8,4" FontSize="11" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" />
            </Grid>
        </Grid>
    </Border>
</Window>
